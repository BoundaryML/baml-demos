# Copy to .env.local and fill in your own credentials. Never commit real keys.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Same WorkOS environment for the API key, client ID, users, and flags.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=

# Optional /login: generate with `openssl rand -hex 32` and keep stable.
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback
