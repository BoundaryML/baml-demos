# Copy to .env.llm_settings. Restart the server after changing these settings.
# Demo 2: independent model choices for the two LLM functions.
LOGO_LLM_PROVIDER=google
LOGO_LLM_MODEL=gemini-3.1-flash-image
COPY_LLM_PROVIDER=openai
COPY_LLM_MODEL=gpt-5.2

# Demo 5: create matching boolean flags in WorkOS.
WORKOS_LOGO_FLAG=launch-logo-upgrade
WORKOS_COPY_FLAG=launch-copy-upgrade

# Optional: filesystem override database (default: .demo-data in this app).
# DEMO_DATA_DIR=/absolute/path/to/demo-data
